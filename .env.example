# ============================================================
#  UangKu — CONTOH berkas rahasia
#  Salin berkas ini menjadi `.env` lalu isi nilainya.
#  🔴 JANGAN pernah mengunggah `.env` yang sudah terisi.
# ============================================================

# --- Jembatan Layerbase (PostgreSQL) ---
# Alamat koneksi pooled (dipakai PC untuk cadangan)
LB_OWNER_URL=postgresql://USER:PASSWORD@HOST:5432/uangku?sslmode=require

# --- HTTP query API Layerbase (dipakai Cloudflare Worker) ---
LB_API_HOST=https://<host>.cloud.layerbase.dev
LB_DB_ID=<id-database>

# Kunci per-database (bukan kunci akun) — dibuat lewat menu Rotate
LB_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# PIN akses dari HP/PC (dikirim Worker di setiap permintaan)
LB_PIN=xxxxxx
